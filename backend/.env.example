# HUAGURUNCHO 360 - Configuración de Entorno (Producción & Desarrollo)
# Dominio Backend Oficial: apih.aquienpasco.com

# Modo de ejecución (False para producción)
DEBUG=False

# Llave secreta criptográfica (generar una única de 50+ caracteres para producción)
SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-aleatoria-de-produccion-2026-huaguruncho!

# Hosts permitidos
ALLOWED_HOSTS=apih.aquienpasco.com,.aquienpasco.com,localhost,127.0.0.1,backend

# Orígenes confiables para CSRF en HTTPS (Django 5 - Imprescindible para Admin y POST)
CSRF_TRUSTED_ORIGINS=https://apih.aquienpasco.com,https://aquienpasco.com,https://*.aquienpasco.com

# CORS (Frontends autorizados para consultar la API)
CORS_ALLOWED_ORIGINS=https://apih.aquienpasco.com,https://aquienpasco.com,https://www.aquienpasco.com,http://localhost:3000,http://127.0.0.1:3000

# Base de Datos (PostgreSQL en producción)
# Opción A - Mediante URL completa:
DATABASE_URL=postgres://huaguruncho_user:huaguruncho_secure_pass_2026@localhost:5432/huaguruncho_db
# Opción B - Mediante variables individuales:
DB_NAME=huaguruncho_db
DB_USER=huaguruncho_user
DB_PASSWORD=huaguruncho_secure_pass_2026
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Seguridad HTTPS y Proxy Reverso (Nginx / Cloudflare / Traefik / ALB)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# JWT Token Lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Servir archivos multimedia localmente si no se usa S3
SERVE_MEDIA=True

# Configuración opcional para S3 (AWS / MinIO / DigitalOcean)
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1

# Límites de carga de archivos (panoramas 360, paquetes offline, audios, APK - 50MB)
DATA_UPLOAD_MAX_MEMORY_SIZE=52428800
FILE_UPLOAD_MAX_MEMORY_SIZE=52428800

# Configuración de Archivos Media & Static
MEDIA_ROOT=media/
MEDIA_URL=/media/
STATIC_ROOT=staticfiles/
STATIC_URL=/static/
